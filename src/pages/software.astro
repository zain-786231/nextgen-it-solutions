---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Visual from '../components/Visual.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CTA from '../components/CTA.astro';
import { Check, MessageCircle, ArrowRight } from '@lucide/astro';
import { site, whatsappLink } from '../config/site';
import { software } from '../data/software';

const schema = software.filter((s) => s.schema).map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: s.name,
  description: s.description,
  applicationCategory: s.schema!.applicationCategory,
  operatingSystem: s.schema!.operatingSystem,
  url: `${site.url}/software/#${s.slug}`,
  publisher: { '@id': `${site.url}/#organization` },
}));
const visualKind = { store: 'pos', scale: 'scale', code: 'code' } as const;
---
<Base
  title="POS Software & Custom Software Development in Pakistan"
  description="DukaanPRO POS software, weighing scale software and custom business software development for retailers and businesses in Pakistan, from NextGen I.T Solutions, Arifwala."
  breadcrumbs={[{ name: 'Software Solutions', path: '/software/' }]}
  schema={schema}>
  <PageHero crumb="Software Solutions" eyebrow="Software solutions" title="Business software for retail, weighing and beyond."
    lead="Point-of-sale, weighing scale integration and custom-built applications for businesses in Pakistan — designed to make daily operations simpler and records more reliable.">
    <nav aria-label="Software products" class="mt-10 flex flex-wrap gap-2">
      {software.map((s) => <a href={`#${s.slug}`} class="btn-ghost !py-2.5">{s.name}</a>)}
    </nav>
  </PageHero>

  {software.map((s, n) => (
    <section id={s.slug} class="container-x scroll-mt-24 pt-24" aria-labelledby={`${s.slug}-h`}>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class:list={[n % 2 === 1 && 'lg:order-2']} data-reveal>
          <div class="flex items-center gap-3"><span class="icon-tile"><Icon name={s.icon as 'store'} /></span><span class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">{s.category}</span></div>
          <h2 id={`${s.slug}-h`} class="h-section mt-5">{s.name}</h2>
          <p class="mt-3 text-lg text-fg/90">{s.summary}</p>
          <p class="mt-4 leading-relaxed text-muted">{s.description}</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {s.features.map((f) => <li class="flex items-start gap-2.5 text-sm"><Check class="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden="true" />{f}</li>)}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={whatsappLink(`Hello ${site.name}, I would like to request a demo of ${s.name}.`)} target="_blank" rel="noopener noreferrer" class="btn-wa"><MessageCircle class="size-4" aria-hidden="true" /> Request a Demo on WhatsApp</a>
            <a href="#software-inquiry" class="btn-ghost">Send an inquiry <ArrowRight class="size-4" aria-hidden="true" /></a>
          </div>
        </div>
        <figure class:list={['card overflow-hidden', n % 2 === 1 && 'lg:order-1']} data-reveal>
          {s.screenshot
            ? <img src={s.screenshot} alt={`${s.name} screenshot`} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
            : <Visual kind={visualKind[s.icon as keyof typeof visualKind] ?? 'software'} label={`${s.name} — illustrative placeholder, not an actual screenshot`} class="aspect-[16/10]" />}
          {!s.screenshot && <figcaption class="border-t border-line px-5 py-3 text-xs text-muted"><span class="placeholder-tag">Placeholder</span> Illustrative graphic — real screenshot to be added.</figcaption>}
        </figure>
      </div>
    </section>
  ))}

  <section class="container-x mt-28 grid gap-12 lg:grid-cols-[1fr_1.3fr]" aria-labelledby="sw-inq-h">
    <div data-reveal>
      <p class="eyebrow">Get started</p>
      <h2 id="sw-inq-h" class="h-section mt-4">Request a demo or discuss a custom project.</h2>
      <p class="lead mt-4">Tell us about your business and what you want the software to do. We will reply with next steps — a demo, a recommendation, or questions to understand your requirements.</p>
    </div>
    <InquiryForm id="software-inquiry" defaultService="DukaanPRO POS Software" heading="Software inquiry" />
  </section>
  <CTA />
</Base>
