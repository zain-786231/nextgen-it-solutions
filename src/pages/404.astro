---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="The page you are looking for could not be found." noindex>
  <section class="container-x grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-mono text-sm text-cyan">404</p>
      <h1 class="h-display mt-4">Page not found.</h1>
      <p class="lead mt-4">The page may have moved. Try one of these instead.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Home</a><a href="/products/" class="btn-ghost">Products</a><a href="/contact/" class="btn-ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>
