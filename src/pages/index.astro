---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import Visual from '../components/Visual.astro';
import SectionHead from '../components/SectionHead.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import {
  ArrowRight, MessageCircle, Check, Router, Network, Wifi, RadioTower, Cable, Layers, Camera, Cctv, HardDrive, Plug,
  MonitorSmartphone, Wrench, Puzzle, Briefcase, Cpu, Headset, Store, Pill, UtensilsCrossed, Warehouse, Factory, Building2, Landmark,
} from '@lucide/astro';
import { site, whatsappLink } from '../config/site';
import { softwareShowcase } from '../data/software';

const capabilities = [
  { kind: 'software', title: 'Custom Business Software', text: 'POS, inventory, billing and custom applications that fit the way your business runs.', href: '/software/', cta: 'Explore software' },
  { kind: 'network', title: 'Networking & IT Infrastructure', text: 'Routers, switches, access points and structured networks for dependable connectivity.', href: '/networking/', cta: 'Explore networking' },
  { kind: 'cctv', title: 'CCTV & Security Systems', text: 'IP and CCTV cameras, NVR/DVR recording and remote viewing for your premises.', href: '/cctv-security/', cta: 'Explore security' },
] as const;
const networking = [
  { i: Router, t: 'Routers' }, { i: Network, t: 'Managed & unmanaged switches' }, { i: Wifi, t: 'Wireless access points' },
  { i: RadioTower, t: 'Network bridges' }, { i: Layers, t: 'Structured networking' }, { i: Cable, t: 'Networking accessories' },
];
const cctv = [
  { i: Camera, t: 'IP Cameras' }, { i: Cctv, t: 'CCTV Cameras' }, { i: HardDrive, t: 'NVR / DVR Systems' },
  { i: Plug, t: 'Surveillance Accessories' }, { i: MonitorSmartphone, t: 'Remote Monitoring' }, { i: Wrench, t: 'Installation & Configuration' },
];
const reasons = [
  { i: Puzzle, t: 'Customized Technology Solutions', d: 'We start from your requirements and recommend what fits — not a one-size package.' },
  { i: Briefcase, t: 'Business-Focused Approach', d: 'Technology decisions are judged by how they help you sell, track and operate.' },
  { i: Cpu, t: 'Software and Hardware Expertise', d: 'Software, networks, cameras and accessories from one team that understands how they connect.' },
  { i: Headset, t: 'Reliable Technical Support', d: 'Help with setup, configuration and questions after your solution is in place.' },
];
const industries = [
  { i: Store, t: 'Retail Shops' }, { i: Pill, t: 'Pharmacies' }, { i: UtensilsCrossed, t: 'Restaurants' }, { i: Warehouse, t: 'Warehouses' },
  { i: Factory, t: 'Manufacturing Units' }, { i: Building2, t: 'Offices' }, { i: Landmark, t: 'Commercial Businesses' },
];
const steps = [
  { t: 'Understand Your Requirements', d: 'We discuss how your business works and what problem needs solving.' },
  { t: 'Recommend the Right Solution', d: 'A clear proposal: software, hardware or both — sized to your needs.' },
  { t: 'Implementation & Configuration', d: 'We install, configure and set the system up for your team.' },
  { t: 'Technical Support', d: 'Guidance and support once your system is running.' },
];
---
<Base
  title="NextGen I.T Solutions — POS Software, Networking & CCTV in Arifwala, Pakistan"
  description="NextGen I.T Solutions in Arifwala delivers custom business software, DukaanPRO POS, weighing scale software, networking equipment, CCTV & security systems and computer accessories across Pakistan.">

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0"></div>
    <div class="glow absolute -left-40 top-0 size-[620px] opacity-70"></div>
    <div class="container-x relative grid items-center gap-16 pb-24 pt-16 sm:pt-24 lg:grid-cols-[1.05fr_1fr] lg:pb-32">
      <div>
        <p class="eyebrow">NextGen I.T Solutions</p>
        <h1 class="h-display mt-6 !text-[2.6rem] sm:!text-6xl lg:!text-[4.1rem]">
          Powering Businesses With <span class="bg-gradient-to-r from-blue to-cyan bg-clip-text text-transparent">Smarter Technology.</span>
        </h1>
        <p class="lead mt-6 max-w-xl">From custom business software to professional networking and security solutions, we help businesses operate smarter, stay connected and grow confidently.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#solutions" class="btn-primary">Explore Our Solutions <ArrowRight class="size-4" aria-hidden="true" /></a>
          <a href="/contact/" class="btn-ghost">Talk to Our Team</a>
        </div>
        <p class="mt-10 text-sm text-muted">{site.altTagline}</p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section id="solutions" class="container-x scroll-mt-24" aria-labelledby="cap-h">
    <SectionHead id="cap-h" eyebrow="What we do" title="Three disciplines. One accountable technology partner." lead="Whether you need software to run your counter, a network to connect your team or cameras to protect your premises, we plan and deliver it together." />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {capabilities.map((c) => (
        <article class="card card-hover group overflow-hidden" data-reveal>
          <Visual kind={c.kind} label={`Illustration: ${c.title}`} class="aspect-[5/3] border-b border-line" />
          <div class="p-6">
            <h3 class="text-xl font-semibold">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{c.text}</p>
            <a href={c.href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan">{c.cta}<ArrowRight class="size-4 transition group-hover:translate-x-1" aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SOFTWARE -->
  <section class="container-x mt-28" aria-labelledby="sw-h">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHead id="sw-h" eyebrow="Software solutions" title="Business software that works the way you do." lead="Ready-to-use products and custom development for shops, distributors and growing businesses in Pakistan." />
      <a href="/software/" class="btn-ghost shrink-0" data-reveal>All software <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {softwareShowcase.map((s) => (
        <article class="card card-hover flex flex-col overflow-hidden" data-reveal>
          <div class="relative">
            <Visual kind={s.icon === 'scale' ? 'scale' : s.icon === 'workflow' ? 'code' : 'pos'} label={`${s.name} — screenshot placeholder`} class="aspect-[16/9] border-b border-line" />
            <span class="placeholder-tag absolute left-3 top-3">Screenshot placeholder</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-3"><span class="icon-tile size-9"><Icon name={s.icon} class="size-4" /></span><h3 class="text-lg font-semibold">{s.name}</h3></div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.text}</p>
            <ul class="mt-4 flex flex-wrap gap-2">{s.features.map((f) => <li class="rounded-full border border-line px-2.5 py-1 text-xs text-muted">{f}</li>)}</ul>
            <div class="mt-auto flex gap-2 pt-6">
              <a href={s.href} class="btn-ghost flex-1 !px-3 !py-2.5">Learn More<span class="sr-only"> about {s.name}</span></a>
              <a href={whatsappLink(`Hello ${site.name}, I would like to request a demo of: ${s.name}.`)} target="_blank" rel="noopener noreferrer" class="btn-primary flex-1 !px-3 !py-2.5">Request a Demo</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- NETWORKING + CCTV -->
  {[
    { id: 'net', eyebrow: 'Networking', title: 'Networks your business can depend on.', lead: 'Equipment and structured setups that keep counters, offices and cameras connected.', kind: 'network', items: networking, href: '/networking/', svc: 'Networking Solutions', reverse: false },
    { id: 'sec', eyebrow: 'CCTV & security', title: 'See what matters, from wherever you are.', lead: 'Camera systems selected for your premises, installed and configured for recording and remote viewing.', kind: 'cctv', items: cctv, href: '/cctv-security/', svc: 'CCTV & Security Systems', reverse: true },
  ].map((b) => (
    <section class="container-x mt-28" aria-labelledby={`${b.id}-h`}>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class:list={[b.reverse && 'lg:order-2']}>
          <SectionHead id={`${b.id}-h`} eyebrow={b.eyebrow} title={b.title} lead={b.lead} />
          <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
            {b.items.map(({ i: I, t }) => <li class="flex items-center gap-3 rounded-xl border border-line bg-ink-800/60 px-4 py-3.5 text-sm font-medium"><I class="size-5 text-cyan" aria-hidden="true" />{t}</li>)}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
            <a href={b.href} class="btn-ghost">Learn more<span class="sr-only"> about {b.eyebrow}</span> <ArrowRight class="size-4" aria-hidden="true" /></a>
            <a href={whatsappLink(`Hello ${site.name}, I have an inquiry about ${b.svc}.`)} target="_blank" rel="noopener noreferrer" class="btn-wa"><MessageCircle class="size-4" aria-hidden="true" /> Send an inquiry</a>
          </div>
        </div>
        <div class:list={['card overflow-hidden', b.reverse && 'lg:order-1']} data-reveal>
          <Visual kind={b.kind as 'network'} label={`Illustration: ${b.eyebrow} equipment`} class="aspect-[5/3.4]" />
        </div>
      </div>
    </section>
  ))}

  <!-- WHY US -->
  <section class="mt-28 border-y border-line/60 bg-ink-900 py-24" aria-labelledby="why-h">
    <div class="container-x">
      <SectionHead id="why-h" eyebrow="Why choose us" title="Practical technology, chosen for your business." center />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map(({ i: I, t, d }) => (
          <div class="card p-6" data-reveal>
            <span class="icon-tile"><I class="size-5" aria-hidden="true" /></span>
            <h3 class="mt-5 text-lg font-semibold">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="container-x mt-28" aria-labelledby="ind-h">
    <SectionHead id="ind-h" eyebrow="Industries" title="Built for the businesses that keep Pakistan running." lead="Our solutions suit a wide range of business types, including:" />
    <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-7" data-reveal>
      {industries.map(({ i: I, t }) => (
        <li class="card card-hover flex flex-col items-start gap-4 p-5"><I class="size-6 text-cyan" aria-hidden="true" /><span class="text-sm font-medium">{t}</span></li>
      ))}
    </ul>
  </section>

  <!-- PROCESS -->
  <section class="container-x mt-28" aria-labelledby="proc-h">
    <SectionHead id="proc-h" eyebrow="How we work" title="A simple, transparent process." />
    <ol class="mt-12 grid gap-6 md:grid-cols-4">
      {steps.map((s, n) => (
        <li class="relative border-t border-line pt-6" data-reveal>
          <span class="absolute -top-px left-0 h-px w-16 bg-gradient-to-r from-blue to-cyan"></span>
          <span class="font-mono text-sm text-cyan">0{n + 1}</span>
          <h3 class="mt-3 text-lg font-semibold">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <CTA />
</Base>
