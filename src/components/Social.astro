---
import { site } from '../config/site';
// Simple brand glyphs (Lucide does not ship brand logos).
const paths: Record<string, string> = {
  facebook: 'M14 9h3V5.5h-3c-2.5 0-4 1.6-4 4V12H7.5v3.5H10V22h3.5v-6.5h3l.5-3.5h-3.5V9.8c0-.5.3-.8.5-.8Z',
  instagram: 'M7.5 2.5h9a5 5 0 0 1 5 5v9a5 5 0 0 1-5 5h-9a5 5 0 0 1-5-5v-9a5 5 0 0 1 5-5Zm4.5 5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm5.25-1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
  linkedin: 'M4 9h3.5v11H4V9Zm1.75-5.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM9.5 9H13v1.6c.5-.9 1.7-1.9 3.6-1.9 3.6 0 4.4 2.3 4.4 5.4V20h-3.5v-5.2c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H9.5V9Z',
  youtube: 'M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z',
  tiktok: 'M16.5 3c.4 2.2 1.8 3.6 4 3.9v3.3a7.4 7.4 0 0 1-4-1.3v6.2A6 6 0 1 1 10.5 9v3.4a2.7 2.7 0 1 0 2.6 2.7V3h3.4Z',
};
const items = Object.entries(site.social).filter(([, url]) => !!url) as [string, string][];
---
{items.length > 0 ? (
  <ul class="flex gap-2">
    {items.map(([k, url]) => (
      <li>
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${site.name} on ${k}`} class="grid size-10 place-items-center rounded-full border border-line text-muted transition hover:border-blue hover:text-fg">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={paths[k]} /></svg>
        </a>
      </li>
    ))}
  </ul>
) : (
  <p class="text-sm text-muted"><span class="placeholder-tag">Social links — to be added</span></p>
)}
