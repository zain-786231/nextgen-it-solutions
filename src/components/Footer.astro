---
import { MapPin, Phone, Mail, MessageCircle, Clock } from '@lucide/astro';
import Logo from './Logo.astro';
import Social from './Social.astro';
import { site, whatsappLink } from '../config/site';
const c = site.contact;
const year = new Date().getFullYear();
const cols = [
  { title: 'Solutions', links: [
    { label: 'Software Solutions', href: '/software/' },
    { label: 'DukaanPRO POS', href: '/software/#dukaanpro-pos' },
    { label: 'Weighing Scale Software', href: '/software/#weighing-scale-software' },
    { label: 'Networking Solutions', href: '/networking/' },
    { label: 'CCTV & Security', href: '/cctv-security/' },
  ]},
  { title: 'Company', links: [
    { label: 'About Us', href: '/about/' },
    { label: 'Products', href: '/products/' },
    { label: 'Contact Us', href: '/contact/' },
    { label: 'Privacy Policy', href: '/privacy-policy/' },
  ]},
];
---
<footer class="relative mt-24 border-t border-line/70 bg-ink-900">
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
    <div class="space-y-5">
      <Logo />
      <p class="max-w-xs text-sm leading-relaxed text-muted">{site.altTagline} IT solutions for businesses across Pakistan, based in {c.city}, {c.region}.</p>
      <Social />
    </div>
    {cols.map((col) => (
      <div>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-fg">{col.title}</h2>
        <ul class="space-y-2.5">
          {col.links.map((l) => <li><a href={l.href} class="text-sm text-muted transition hover:text-fg">{l.label}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-fg">Contact</h2>
      <ul class="space-y-3 text-sm text-muted">
        <li class="flex gap-3"><MapPin class="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden="true" /><span>{c.streetAddress ? `${c.streetAddress}, ` : ''}{c.city}, {c.region}, {c.country}{!c.streetAddress && <> <span class="placeholder-tag">street address pending</span></>}</span></li>
        <li class="flex gap-3"><Phone class="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden="true" />{c.phone ? <a href={`tel:${c.phone.replace(/\s/g, '')}`} class="hover:text-fg">{c.phone}</a> : <span class="placeholder-tag">Phone — to be added</span>}</li>
        <li class="flex gap-3"><Mail class="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden="true" />{c.email ? <a href={`mailto:${c.email}`} class="hover:text-fg">{c.email}</a> : <span class="placeholder-tag">Email — to be added</span>}</li>
        {c.hours && <li class="flex gap-3"><Clock class="mt-0.5 size-4 shrink-0 text-cyan" aria-hidden="true" />{c.hours}</li>}
        <li><a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-2 font-medium text-[#3ddc84] hover:underline"><MessageCircle class="size-4" aria-hidden="true" /> Message us on WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line/60">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
