---
interface Props { eyebrow: string; title: string; lead?: string; center?: boolean; id?: string }
const { eyebrow, title, lead, center = false, id } = Astro.props;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="h-section mt-4">{title}</h2>
  {lead && <p class="lead mt-4">{lead}</p>}
</div>
