---
/** Shared template for Networking and CCTV pages */
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Visual from './Visual.astro';
import SectionHead from './SectionHead.astro';
import InquiryForm from './InquiryForm.astro';
import CTA from './CTA.astro';
import { MessageCircle, ArrowRight, Check } from '@lucide/astro';
import { site, whatsappLink } from '../config/site';

interface Item { icon: any; title: string; text: string }
interface Props {
  seoTitle: string; seoDescription: string; crumb: string; path: string;
  eyebrow: string; title: string; lead: string; kind: 'network' | 'cctv';
  items: Item[]; approachTitle: string; approach: string[]; service: string; productCategory: string;
}
const p = Astro.props;
---
<Base title={p.seoTitle} description={p.seoDescription} breadcrumbs={[{ name: p.crumb, path: p.path }]}>
  <PageHero crumb={p.crumb} eyebrow={p.eyebrow} title={p.title} lead={p.lead}>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href={whatsappLink(`Hello ${site.name}, I have an inquiry about ${p.service}.`)} target="_blank" rel="noopener noreferrer" class="btn-wa"><MessageCircle class="size-4" aria-hidden="true" /> Inquire on WhatsApp</a>
      <a href={`/products/?category=${p.productCategory}`} class="btn-ghost">Browse products <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
  </PageHero>

  <section class="container-x pt-24" aria-labelledby="items-h">
    <SectionHead id="items-h" eyebrow="What we offer" title="Equipment and services" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {p.items.map(({ icon: I, title, text }) => (
        <article class="card card-hover flex flex-col p-6" data-reveal>
          <span class="icon-tile"><I class="size-5" aria-hidden="true" /></span>
          <h3 class="mt-5 text-lg font-semibold">{title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{text}</p>
          <a href={whatsappLink(`Hello ${site.name}, I would like to ask about: ${title}.`)} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan hover:underline">Ask about this <ArrowRight class="size-4" aria-hidden="true" /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="container-x mt-28 grid items-center gap-12 lg:grid-cols-2" aria-labelledby="appr-h">
    <div class="card overflow-hidden" data-reveal><Visual kind={p.kind} label={`Illustration: ${p.crumb}`} class="aspect-[5/3.4]" /></div>
    <div data-reveal>
      <p class="eyebrow">Our approach</p>
      <h2 id="appr-h" class="h-section mt-4">{p.approachTitle}</h2>
      <ul class="mt-8 space-y-4">
        {p.approach.map((a) => <li class="flex gap-3 text-muted"><Check class="mt-1 size-4 shrink-0 text-cyan" aria-hidden="true" /><span>{a}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="container-x mt-28 grid gap-12 lg:grid-cols-[1fr_1.3fr]" aria-labelledby="svc-inq-h">
    <div data-reveal>
      <p class="eyebrow">Request a quote</p>
      <h2 id="svc-inq-h" class="h-section mt-4">Tell us about your site.</h2>
      <p class="lead mt-4">Share the size of your premises, what you need covered or connected, and any equipment you already have. We will get back to you with a recommendation.</p>
    </div>
    <InquiryForm id="service-inquiry" defaultService={p.service} heading={`${p.crumb} inquiry`} />
  </section>
  <CTA />
</Base>
